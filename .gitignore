.test-sandbox
node_modules
site/.astro/
site/dist/
site/node_modules/

# Token Budget Analyst dataset: harvested corpus is local + regenerable from the
# harvester; it is NOT committed to this public repo (even scrubbed, it is internal
# operational data). The harvester CODE is tracked; the DATA stays local.
tools/token-budget-dataset/dataset/

# Python bytecode (the harvester is stdlib Python)
__pycache__/
*.pyc

# Specialist runtime state (mutates at runtime; the registry specialists.json IS tracked)
.role-os/specialist-state.json
.role-os/specialist-events.jsonl

# Conformance training run logs/peaks (local; the dataset, scripts + certify receipts ARE tracked)
tools/conformance-dataset/*.log

# Dossier: portraits are hosted in the brand asset repo (mcp-tool-shop-org/brand,
# logos/role-dossier/) and referenced by raw-CDN URL — the local renders + scratch
# helpers are not committed here. The runtime data the package needs is src/role-dossiers.json.
dossier/portraits/renders/
dossier/_*.mjs
